{
  "name": "devicegate",
  "version": "0.1.0",
  "description": "Self-hosted gateway that gives each of your machines its own key, model access, limits and usage tracking for Claude Code on your Claude subscription.",
  "license": "MIT",
  "author": "Jayesh Kugsiya",
  "homepage": "https://github.com/jkugsiya/DeviceGate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkugsiya/DeviceGate.git"
  },
  "bugs": {
    "url": "https://github.com/jkugsiya/DeviceGate/issues"
  },
  "keywords": [
    "claude-code",
    "gateway",
    "proxy",
    "self-hosted",
    "rate-limiting",
    "usage-tracking",
    "nextjs",
    "sqlite"
  ],
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "device": "tsx --env-file-if-exists=.env.local scripts/device.ts",
    "admin": "tsx --env-file-if-exists=.env.local scripts/admin.ts",
    "init-env": "bun scripts/init-env.ts",
    "recompute-costs": "tsx --env-file-if-exists=.env.local scripts/recompute-costs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

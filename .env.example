# Copy to .env.local and fill in, or run `bun run init-env` to generate it. Never commit .env.local.

# TeamClaude on this machine. The key is proxy.apiKey in ~/.config/teamclaude.json.
UPSTREAM_URL=http://127.0.0.1:3456
UPSTREAM_API_KEY=

DATABASE_PATH=./data/gateway.db

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# This machine's LAN address, as PCs and your browser will reach it.
BETTER_AUTH_URL=http://192.168.x.x:3000
ADMIN_TRUSTED_ORIGINS=http://192.168.x.x:3000,http://localhost:3000

# IANA timezone for quota days (start at local midnight) and weeks (start Monday), and for times
# shown in the admin. Defaults to the server's timezone.
TIMEZONE=

# URL written into each device's ANTHROPIC_BASE_URL. Defaults to BETTER_AUTH_URL; set it only if
# devices reach the gateway at a different address than your browser does.
# GATEWAY_PUBLIC_URL=
